# Sao chép thành .env (file .env đã được .gitignore bỏ qua — không commit giá trị thật)

# Địa chỉ API Gateway (mọi request frontend đều đi qua đây)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Thông tin nhận chuyển khoản VietQR hiển thị sau khi đặt hàng.
# Để trống => không hiển thị mã QR (tránh khách chuyển nhầm vào tài khoản mẫu).
# VITE_VIETQR_BANK_ID: mã ngân hàng theo chuẩn VietQR, ví dụ MB, VCB, TCB...
VITE_VIETQR_BANK_ID=
VITE_VIETQR_ACCOUNT_NO=
VITE_VIETQR_ACCOUNT_NAME=
